{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["api/jobs.json"] }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/recommend",         "dest": "api/index.py" },
    { "src": "/refine",            "dest": "api/index.py" },
    { "src": "/static/styles.css", "dest": "/public/styles.css" },
    { "src": "/static/app.js",     "dest": "/public/app.js" },
    { "src": "/(.*)",              "dest": "/public/index.html" }
  ]
}
