# Groq API key — required for all LLM tool calls
# Get yours free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace Inference API token — required for semantic embeddings on Vercel
# Get yours free at https://huggingface.co/settings/tokens
HF_API_TOKEN=your_hf_api_token_here

# (Optional) Override the Groq model. Default: llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.1-8b-instant
